<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Habilita el control sobre el módulo de la cámara y flash -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Permite obtener las coordenadas del GPS exactas. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Permite obtener una ubicación aproximada basada en antenas de telefonía o redes WiFi. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Define si existe la camara con flash en un dispositivo -->
    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />

    <!-- Define si existe la camara en un dispositivo -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/Asistente"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AsistenteTerreno">
        <activity
            android:name=".Inicio"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".SegundaVista"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".AyudaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ConfigActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>