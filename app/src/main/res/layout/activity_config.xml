<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp">

        <!-- TÍTULO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙️ Configuración"
            android:textStyle="bold"
            android:textSize="26sp"
            android:textAlignment="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ajustes de Tema y Sincronización de Datos"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="24dp" />

        <!-- SECCIÓN 1: APARIENCIA (MODO OSCURO / CLARO) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎨 Apariencia Visual"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchModoOscuro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌙 Modo Oscuro"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="8dp"
            android:layout_marginBottom="28dp" />

        <!-- SECCIÓN 2: CONCURRENCIA / SINCRONIZACIÓN -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔄 Concurrencia y Servidor Remoto"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="12dp" />

        <!-- ESTADO DE LA SINCRONIZACIÓN -->
        <TextView
            android:id="@+id/tvEstadoSync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estado: Esperando orden de sincronización..."
            android:textAlignment="center"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <!-- DETALLE / LOG DE PROCESO -->
        <TextView
            android:id="@+id/tvDetalleSync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Presione el botón para iniciar la sincronización de paquetes en un hilo secundario."
            android:textAlignment="center"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="18dp" />

        <!-- BARRA DE PROGRESO INDETERMINADA -->
        <ProgressBar
            android:id="@+id/progressBarSync"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginBottom="20dp" />

        <!-- BOTÓN DE SINCRONIZAR (DISPARA EL THREAD) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSincronizar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔄 Sincronizar Datos con Servidor"
            android:textStyle="bold"
            android:textSize="16sp"
            android:padding="14dp"
            android:layout_marginBottom="16dp"
            android:background="@color/btn_background"
            android:textColor="@color/btn_text" />

        <!-- BOTÓN VOLVER -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnVolverConfig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔙 Volver al Inicio"
            android:textStyle="bold"
            android:textSize="16sp"
            android:padding="14dp"
            android:layout_marginBottom="20dp"
            android:background="@color/btn_background"
            android:textColor="@color/btn_text" />

    </LinearLayout>
</ScrollView>